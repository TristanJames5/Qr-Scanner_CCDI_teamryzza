# .env.example
# Copy this file to server/.env and fill in your values.
# NEVER commit the actual .env file — it is gitignored.
# Run: cp server/.env.example server/.env

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Client URL ───────────────────────────────────────────────────────────────
# Used for CORS whitelist. Comma-separate multiple origins.
# Example for production: CLIENT_URL=https://ccdi-qrscan.onrender.com
CLIENT_URL=http://localhost:5173

# ─── Required Secrets ─────────────────────────────────────────────────────────
# ⚠️  REQUIRED — the server refuses to start in production without these.
# Generate secure values with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Used to sign and verify JWT authentication tokens (7-day expiry)
JWT_SECRET=replace-me-with-a-random-64-char-hex-string

# Used to sign HMAC-SHA256 QR rotation tokens (anti-proxy engine)
QR_HMAC_SECRET=replace-me-with-a-different-random-64-char-hex-string

# ─── Cloud Database (Optional — for persistent Render deployments) ─────────────
# Leave empty to use local SQLite (development).
# Set these if you connect to Turso (cloud SQLite):
# TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# ─── Geo-Fence Configuration ───────────────────────────────────────────────────
# GPS coordinates of your CCDI campus. Students must be within MAX_DISTANCE_METERS to scan.
# Find your coordinates on: https://www.google.com/maps (right-click → "What's here?")
CAMPUS_LAT=12.9749
CAMPUS_LNG=124.0058
MAX_DISTANCE_METERS=500

# ─── Cloudinary (For Excuse Letter Image Uploads) ──────────────────────────────
# Create a free account at: https://cloudinary.com/
# Get these values from your Cloudinary Dashboard → Settings → API Keys
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

