# Server Environment Variables (Render Web Service)
PORT=5000
NODE_ENV=production

# Security Keys (Generate random 32+ character strings for production)
JWT_SECRET=replace_with_a_secure_jwt_secret_at_least_32_characters
QR_HMAC_SECRET=replace_with_a_secure_hmac_secret_at_least_32_characters

# CORS Whitelist (Your Vercel deployment URL)
CLIENT_URL=https://your-frontend-name.vercel.app,http://localhost:5173

